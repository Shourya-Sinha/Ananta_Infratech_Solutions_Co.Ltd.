# Production configuration — do not commit the real .env file
PORT=5050
# Optional: if blank, a persistent local JSON CMS fallback is used for development
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/ananta
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@anantainfratech.com
# Prefer an ADMIN_PASSWORD_HASH generated with bcrypt for production
ADMIN_PASSWORD=change-this-immediately
# ADMIN_PASSWORD_HASH=$2a$12$...

# Image uploads — optional Cloudinary storage.
# When these are set, admin uploads are sent to Cloudinary and the returned
# secure public URL is stored in the CMS. If they are blank, images are saved
# to server/uploads and served from /uploads instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=ananta-infratech
# Alternative to the API key/secret pair: an unsigned upload preset
# CLOUDINARY_UPLOAD_PRESET=
