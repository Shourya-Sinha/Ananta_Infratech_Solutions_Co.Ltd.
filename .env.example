# Copy this file to `.env` in the project root and fill in the values.
# Never commit the real `.env` — it is git-ignored.

# ---------------------------------------------------------------- site
PORT=5050
SITE_URL=https://anantainfratechsolutions.com
# NODE_ENV=production

# ------------------------------------------------------------- admin login
ADMIN_EMAIL=support@anantainfratechsolutions.com
ADMIN_PASSWORD=change-this-password
# A bcrypt hash wins over ADMIN_PASSWORD when both are set.
# ADMIN_PASSWORD_HASH=
JWT_SECRET=replace-with-a-long-random-string

# --------------------------------------------------------------- database
# Leave blank to use the durable JSON store at server/data/cms.json.
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/ananta

# ------------------------------------------------------- email delivery
# Every website form is emailed here. Use the mailbox you actually read.
#
# This domain's mail is hosted by GoDaddy (MX: smtp/mailstore.secureserver.net),
# so the outgoing server is smtpout.secureserver.net on port 465 with SSL.
# The simplest correct setup is the MAIL_PROVIDER preset below — the host,
# port and encryption are filled in for you:
#
#   MAIL_PROVIDER=godaddy
#   SMTP_USER=support@anantainfratechsolutions.com
#   SMTP_PASS="the mailbox password"
#
# If SMTP_HOST and MAIL_PROVIDER are both left blank, the host is detected from
# the SMTP_USER domain's MX records at startup.
#
# Other presets: titan, microsoft365, gmail, zoho, zoho-in, zoho-eu, hostinger,
# namecheap, brevo, sendgrid, mailgun, resend, ses — or set SMTP_HOST directly:
#   Zoho (custom domain)   SMTP_HOST=smtp.zoho.in            SMTP_PORT=465 SMTP_SECURE=true
#   Google Workspace       SMTP_HOST=smtp.gmail.com          SMTP_PORT=465 SMTP_SECURE=true
#   Microsoft 365          SMTP_HOST=smtp.office365.com      SMTP_PORT=587 SMTP_SECURE=false
#   Hostinger              SMTP_HOST=smtp.hostinger.com      SMTP_PORT=465 SMTP_SECURE=true
MAIL_PROVIDER=godaddy
# Leave both blank to auto-detect from the domain's MX records.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@anantainfratechsolutions.com
# GoDaddy: the mailbox password (what you use at webmail), NOT the GoDaddy
# account password. "SMTP Authentication" must be switched on for the mailbox:
# Email & Office dashboard -> Manage -> Advanced Settings -> SMTP Authentication.
# Tip: run `npm run mail:check` to test the credentials without the website.
# If the password contains a space or #, wrap it in double quotes: "pa#ss word".
SMTP_PASS=
# The From address. It must normally match the mailbox you authenticate as.
MAIL_FROM=Ananta Infratech Solutions <support@anantainfratechsolutions.com>
# Where enquiries are delivered (comma-separated for more than one inbox).
MAIL_TO=support@anantainfratechsolutions.com
# Set to true to send the person who wrote in a short confirmation email.
MAIL_ACK=true
# Runs a DNS/TCP/TLS/sign-in self-check at startup and logs the result.
MAIL_VERIFY_ON_BOOT=true
# Set to false to skip MX-based provider detection.
MAIL_DETECT=true
# Verbose SMTP conversation in the server log, only while debugging.
SMTP_DEBUG=false

# ------------------------------------------------ optional webhook / Slack
# NOTIFY_WEBHOOK_URL=
# NOTIFY_WEBHOOK_SECRET=

# --------------------------------------------------------- image storage
# Uploads are stored in server/uploads unless Cloudinary is configured.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
