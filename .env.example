# Production configuration — do not commit the real .env file
PORT=5050
# Optional: if blank, a persistent local JSON CMS fallback is used for development
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/ananta
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@anantainfratech.com
# Prefer an ADMIN_PASSWORD_HASH generated with bcrypt for production
ADMIN_PASSWORD=change-this-immediately
# ADMIN_PASSWORD_HASH=$2a$12$...
